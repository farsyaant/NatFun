# Variabel lingkungan NatFun (isi nilai di .env.local — JANGAN commit nilainya)
# Vite hanya membaca env saat dev server / build DIMULAI — restart setelah mengubah.

# WebID pemilik Official Pod (Admin). Wajib benar agar katalog resmi terjangkau.
VITE_NATFUN_ADMIN_WEBID=https://admin-anda.solidcommunity.net/profile/card#me

# (Opsional) URL IdP CSS lokal untuk preset "CSS Lokal (dev)"
VITE_NATFUN_LOCAL_IDP=http://localhost:3000/

# --- Khusus script seeding (set di shell atau file .env.seed yang di-gitignore) ---
# SEED_IDP=https://solidcommunity.net/
# SEED_CLIENT_ID=<token identifier dari .account/ → Client credentials>
# SEED_CLIENT_SECRET=<client secret>